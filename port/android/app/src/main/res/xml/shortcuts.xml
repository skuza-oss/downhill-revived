<?xml version="1.0" encoding="utf-8"?>
<!-- The icon's long-press menu: Share log (finding 152) opens the share sheet with the game's log
     (LauncherActivity's SHARE_LOG start, LogShare.java) without starting the game, for a phone where
     the game closes before anything on the screen can help; Launcher (finding 225) opens the
     launcher's page even when "Open the launcher at every start" is off. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="share_log"
        android:enabled="true"
        android:icon="@drawable/ic_share_log"
        android:shortcutShortLabel="@string/share_log"
        android:shortcutLongLabel="@string/share_log_long">
        <intent
            android:action="app.downhillrevived.SHARE_LOG"
            android:targetPackage="app.downhillrevived"
            android:targetClass="app.downhillrevived.LauncherActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="launcher"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_page"
        android:shortcutShortLabel="@string/open_launcher"
        android:shortcutLongLabel="@string/open_launcher_long">
        <intent
            android:action="app.downhillrevived.OPEN_LAUNCHER"
            android:targetPackage="app.downhillrevived"
            android:targetClass="app.downhillrevived.LauncherActivity" />
    </shortcut>
</shortcuts>
