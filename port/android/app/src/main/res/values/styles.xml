<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, black behind the game (SDL's template theme) -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!-- The launcher (LauncherActivity): its ground colour behind the page; the page stays clear of
         a camera cutout (never: the window avoids it, the ground colour fills the strip) -->
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorAccent">@color/ember</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
</resources>
