<?xml version="1.0" encoding="utf-8"?>
<!-- Downhill Revived on Android (finding 091). After SDL's android-project template (SDL 3.4.18):
     one landscape activity over SDL's SDLActivity, gamepads (Bluetooth or USB) and the touch controls (finding 139). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <!-- The renderer is wgpu on Vulkan (1.1: every arm64 phone since 2018). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Controller rumble -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The online menu (its server list) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <activity android:name=".DhdActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USB controllers -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
