<?xml version="1.0" encoding="utf-8"?>
<!-- Downhill Revived on Android (finding 091). After SDL's android-project template (SDL 3.4.18):
     one landscape activity over SDL's SDLActivity, gamepads (Bluetooth or USB) and the touch controls (finding 141). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <!-- The renderer is wgpu on Vulkan (1.1: every arm64 phone since 2018). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Controller rumble -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The update notice (port/host/android_update.c, finding 143): once a day it asks the online
         server, then GitHub, whether a newer release has an APK. Phones have no online play yet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- The launcher (LauncherActivity.java, finding 225): the launcher's page (port/launcher/ui,
             in the assets) at every start, the disc image's import, then the game. Portrait or
             landscape, as the device is held (the game itself is landscape). Its configChanges are
             DhdActivity's and density, mcc and mnc: a rotation, a font size, language, display or SIM
             change keeps the activity (and so the page and a copy in progress) instead of making it
             again. -->
        <activity android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:theme="@style/LauncherTheme"
            android:screenOrientation="fullUser"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|density|mcc|mnc|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The icon's long-press shortcuts: Share log, without starting the game (finding 152), and
                 Launcher, the page even when the game is set to start directly (finding 225) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity android:name=".DhdActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <!-- USB controllers -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>

        <!-- The shared log's file for the app the player shares it with (LogShare.java, finding
             152): not exported, read only through the share's grant; our own, no androidx -->
        <provider android:name=".LogProvider"
            android:authorities="app.downhillrevived.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
